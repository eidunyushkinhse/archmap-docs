# Настройки сервера документации (скопировать в .env; файл в .gitignore).
# Пароль автора: хэш пишет команда `npm run password`; для локальной разработки можно
# задать пароль открытым текстом переменной DOCS_AUTHOR_PASSWORD.
DOCS_AUTHOR_PASSWORD_HASH=
# DOCS_AUTHOR_PASSWORD=
# Ключ подписи сессий; если не задан — создаётся и хранится в .data/session-secret
# DOCS_SESSION_SECRET=
# Порт и адрес (по умолчанию 8800 на 127.0.0.1)
# DOCS_PORT=8800
# DOCS_HOST=127.0.0.1
# За обратным прокси с TLS (nginx): адрес клиента и схема — из X-Forwarded-*, cookie — Secure
# DOCS_TRUST_PROXY=true
# Языки сайта: ru или ru,en; не задано — все, что есть в content/ (стенд: только русский)
# DOCS_LANGS=ru

# Автокоммит: после каждой правки через редактор сервер коммитит content/ (если папка —
# в рабочей копии git). Выключить — DOCS_GIT_AUTOCOMMIT=false.
# DOCS_GIT_AUTOCOMMIT=true
# Отправлять коммиты в удалённый репозиторий (стенд; нужен ключ с правом записи, см. README).
# Отклонённая отправка повторяется после pull --rebase; ошибка видна автору в редакторе.
# DOCS_GIT_PUSH=true
# DOCS_GIT_REMOTE=origin
# Автор коммитов сервера; если не задан — git config рабочей копии, иначе
# «Автор документации <docs@archmap.tech>»
# DOCS_GIT_NAME=
# DOCS_GIT_EMAIL=
