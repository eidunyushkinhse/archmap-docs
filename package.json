{
  "name": "archmap-docs",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Пользовательская документация ArchMap (docs.archmap.tech): Markdown-руководства и свой движок-вики с авторским режимом",
  "repository": "github:eidunyushkinhse/archmap-docs",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node src/build.ts",
    "dev": "node src/server.ts --dev",
    "start": "node src/server.ts",
    "password": "node src/server.ts --set-password",
    "report": "node src/build.ts --report",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "hooks": "git config core.hooksPath scripts/git-hooks"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.5",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.1.2",
    "typescript": "^7.0.2"
  }
}
